# ==========================================
# KRIA AI - Environment Configuration Template
# ==========================================

# Public Supabase Configuration (Available in Browser and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-Only Supabase Configuration (NEVER prefix with NEXT_PUBLIC)
# Used only by backend seed scripts or server-side administrative procedures
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI Provider (Server-Side Only)
# Official SDK: @google/genai (Gemini 3.5 Flash Lite)
# Can use either GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=your-gemini-api-key

# Authenticated Test & Procedure Credentials (Server-Side Verification Only)
KRIA_ADMIN_EMAIL=admin@kriatech.com
KRIA_ADMIN_PASSWORD=your-secure-admin-password

# Optional Automation / n8n Webhook Configuration (Server-Side Only)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/kria
N8N_API_KEY=your-n8n-api-key
